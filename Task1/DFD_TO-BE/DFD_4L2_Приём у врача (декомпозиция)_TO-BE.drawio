arget="D2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8l" value="заключения и сканы [PHI]&lt;br&gt;(в защищённое хранилище)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="641" y="629" width="172" height="34" as="geometry"/></mxCell><mxCell id="e8a" value="AES-256 и сроки хранения" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5c00;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="641" y="527" width="172" height="24" as="geometry"/></mxCell><mxCell id="e8c" value="" style="html=1;endArrow=none;rounded=0;dashed=1;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1" source="e8l" target="e8a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b0" value="#1.2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1092" y="640" width="40" height="18" as="geometry"/></mxCell><mxCell id="b1" value="#3.1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1092" y="250" width="40" height="18" as="geometry"/></mxCell><mxCell id="b2" value="#3.2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="612" y="375" width="40" height="18" as="geometry"/></mxCell><mxCell id="legend" value="Обозначения&lt;br&gt;Pn — процесс обработки данных&lt;br&gt;Dn — хранилище данных&lt;br&gt;En — внешний субъект или система&lt;br&gt;красный пунктир — конфиденциальный поток&lt;br&gt;[PII] [PHI] [FIN] [HR] [CONF] — класс данных&lt;br&gt;#N — проблемное место (см. 02_Список_проблем.md)&lt;br&gt;жёлтая плашка у потока — мера защиты, которая применяется на этом этапе&lt;br&gt;(в скобках у хранилища) — что с ним происходит в целевом состоянии" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="400" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>