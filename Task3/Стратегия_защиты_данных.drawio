<mxfile host="app.diagrams.net" version="24.0.0"><diagram name="Защита данных" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Стратегия защиты данных «Медикаменте»" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry"/></mxCell><mxCell id="h0" value="Класс данных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="250" height="50" as="geometry"/></mxCell><mxCell id="h1" value="В покое (at rest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="370" height="50" as="geometry"/></mxCell><mxCell id="h2" value="В передаче (in transit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="100" width="370" height="50" as="geometry"/></mxCell><mxCell id="h3" value="В использовании (in use)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="100" width="380" height="50" as="geometry"/></mxCell><mxCell id="c1" value="Особый&lt;br&gt;медданные: диагнозы, анализы&lt;br&gt;[at rest, in transit, in use]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="250" height="90" as="geometry"/></mxCell><mxCell id="c2" value="Высокий&lt;br&gt;паспорт, платежи, зарплаты, AD&lt;br&gt;[at rest, in transit, in use]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="250" height="90" as="geometry"/></mxCell><mxCell id="c3" value="Средний&lt;br&gt;ФИО, контакты, записи на приём&lt;br&gt;[at rest, in transit]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="250" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Внутренний&lt;br&gt;справочники, ТМЦ, агрегаты&lt;br&gt;[at rest, in use]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="250" height="90" as="geometry"/></mxCell><mxCell id="t00" value="FDE и SED&lt;br&gt;шифрование дисков серверов и ноутбуков" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="330" y="175" width="370" height="90" as="geometry"/></mxCell><mxCell id="t01" value="TDE PostgreSQL (AES-256)&lt;br&gt;шифрование базы целиком, прозрачно для приложений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="330" y="280" width="370" height="90" as="geometry"/></mxCell><mxCell id="t02" value="Шифрование колонок (pgcrypto)&lt;br&gt;диагнозы, паспорта, ИНН, СНИЛС" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="330" y="385" width="370" height="90" as="geometry"/></mxCell><mxCell id="t03" value="SSE-KMS для объектного хранилища&lt;br&gt;сканы, анализы, вложения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="330" y="490" width="370" height="90" as="geometry"/></mxCell><mxCell id="t04" value="Шифрование резервных копий&lt;br&gt;бэкапы и изолированное хранилище" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="330" y="595" width="370" height="90" as="geometry"/></mxCell><mxCell id="t10" value="TLS 1.3 на всех каналах&lt;br&gt;старые версии TLS и SSL отключены" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="730" y="175" width="370" height="90" as="geometry"/></mxCell><mxCell id="t11" value="mTLS&lt;br&gt;API лаборатории и межсервисные вызовы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="730" y="280" width="370" height="90" as="geometry"/></mxCell><mxCell id="t12" value="VPN (WireGuard) и SSH&lt;br&gt;административный доступ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="730" y="385" width="370" height="90" as="geometry"/></mxCell><mxCell id="t13" value="Сертификаты и ротация&lt;br&gt;свой CA для внутренних сервисов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="730" y="490" width="370" height="90" as="geometry"/></mxCell><mxCell id="t14" value="API Gateway&lt;br&gt;валидация контрактов, rate limit, схема ответа" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="730" y="595" width="370" height="90" as="geometry"/></mxCell><mxCell id="t20" value="Шифрование на уровне приложения&lt;br&gt;расшифровка на время операции, затирание буфера" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1130" y="175" width="380" height="90" as="geometry"/></mxCell><mxCell id="t21" value="Токенизация&lt;br&gt;реквизиты и идентификаторы вместо реальных значений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1130" y="280" width="380" height="90" as="geometry"/></mxCell><mxCell id="t22" value="Проверка доступа на каждом запросе&lt;br&gt;PDP, RBAC и ABAC, принадлежность записи" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1130" y="385" width="380" height="90" as="geometry"/></mxCell><mxCell id="t23" value="Минимизация данных в памяти&lt;br&gt;текущий набор вместо всей базы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1130" y="490" width="380" height="90" as="geometry"/></mxCell><mxCell id="t24" value="TEE (Intel SGX)&lt;br&gt;опция для отдельных операций" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1130" y="595" width="380" height="90" as="geometry"/></mxCell><mxCell id="keys" value="&lt;b&gt;Управление ключами&lt;/b&gt;&lt;br&gt;Vault для ключей и секретов · HSM для мастер-ключей · разделение ключей по средам · ротация и срок жизни · аудит доступа к ключам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="730" width="1180" height="80" as="geometry"/></mxCell><mxCell id="ctrl" value="&lt;b&gt;Автоматизированный контроль&lt;/b&gt;&lt;br&gt;аудит чтения и изменения медданных · SIEM: корреляция событий и алерты · DLP: выгрузки, файлы, почта · проверки перед релизом: теги, секреты, PII в логах · метрики: покрытие тегами, доля TLS 1.3, просроченные сроки хранения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="830" width="1180" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>