<mxfile host="app.diagrams.net" version="24.0.0"><diagram name="Исикава" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Узкие места при миграции системы «Медикаменте»" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1870" height="40" as="geometry"/></mxCell><mxCell id="head" value="Риск снижения производительности,&lt;br&gt;стабильности и срыва сроков&lt;br&gt;после перехода" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="560" width="330" height="140" as="geometry"/></mxCell><mxCell id="tail" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="140" y="622" width="16" height="16" as="geometry"/></mxCell><mxCell id="spine" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=4;strokeColor=#333333;endFill=1;" edge="1" parent="1" source="tail" target="head"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cat0" value="&lt;b&gt;Инфраструктура&lt;/b&gt;&lt;br&gt;• один сервер в том же здании&lt;br&gt;• на нём AD, DNS, DHCP, LDAP, файлы, Exchange&lt;br&gt;• нет сред dev / test / prod&lt;br&gt;• офисная сеть без сегментации&lt;br&gt;• рост объёма данных в пять раз" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="330" height="175" as="geometry"/></mxCell><mxCell id="at0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="395" y="630" width="2" height="2" as="geometry"/></mxCell><mxCell id="cat1" value="&lt;b&gt;Данные&lt;/b&gt;&lt;br&gt;• Excel, сканы, PDF, JPG и две базы 1С&lt;br&gt;• нет единого идентификатора пациента&lt;br&gt;• дубли и неполные записи&lt;br&gt;• классификация и теги отсутствуют&lt;br&gt;• нет Data Lineage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="330" height="175" as="geometry"/></mxCell><mxCell id="at1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="755" y="630" width="2" height="2" as="geometry"/></mxCell><mxCell id="cat2" value="&lt;b&gt;Программное обеспечение&lt;/b&gt;&lt;br&gt;• 1С в файловом режиме: блокировки&lt;br&gt;• логика в Excel-макросах и головах&lt;br&gt;• двойной учёт: таблица кассира и 1С&lt;br&gt;• автотестов нет&lt;br&gt;• границы доменов не определены" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="330" height="175" as="geometry"/></mxCell><mxCell id="at2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1115" y="630" width="2" height="2" as="geometry"/></mxCell><mxCell id="cat3" value="&lt;b&gt;Интеграция&lt;/b&gt;&lt;br&gt;• ККМ и 1С связаны через OLE по TCP/IP&lt;br&gt;• обмен с лабораторией вручную, почтой&lt;br&gt;• нет API-контрактов и версионирования&lt;br&gt;• нет повторных попыток при сбое&lt;br&gt;• несколько источников на один процесс" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="330" height="175" as="geometry"/></mxCell><mxCell id="at3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1475" y="630" width="2" height="2" as="geometry"/></mxCell><mxCell id="cat4" value="&lt;b&gt;Персонал и организация&lt;/b&gt;&lt;br&gt;• IT-отдел три человека, роли совмещены&lt;br&gt;• нет опыта Kubernetes и микросервисов&lt;br&gt;• активный найм: процессы не передаются&lt;br&gt;• аналитик в отрыве от разработки&lt;br&gt;• сопротивление изменениям у сотрудников" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="200" y="980" width="330" height="175" as="geometry"/></mxCell><mxCell id="at4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="495" y="630" width="2" height="2" as="geometry"/></mxCell><mxCell id="cat5" value="&lt;b&gt;Процессы&lt;/b&gt;&lt;br&gt;• нет CI/CD, релизы ставятся руками&lt;br&gt;• нагрузочное тестирование не проводилось&lt;br&gt;• мониторинга и алертинга нет&lt;br&gt;• план cutover и откат не проработаны&lt;br&gt;• нет регламента инцидентов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B1DDF0;strokeColor=#10739E;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="600" y="980" width="330" height="175" as="geometry"/></mxCell><mxCell id="at5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="895" y="630" width="2" height="2" as="geometry"/></mxCell><mxCell id="cat6" value="&lt;b&gt;Безопасность и соответствие&lt;/b&gt;&lt;br&gt;• аудита действий с данными нет&lt;br&gt;• шифрование не внедрено нигде&lt;br&gt;• доступ внутри приложений не разграничен&lt;br&gt;• согласия не связаны с системами&lt;br&gt;• шифрование в горячем пути даёт задержку" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1000" y="980" width="330" height="175" as="geometry"/></mxCell><mxCell id="at6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1295" y="630" width="2" height="2" as="geometry"/></mxCell><mxCell id="b0" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#7F7F7F;" edge="1" parent="1" source="cat0" target="at0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b1" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#7F7F7F;" edge="1" parent="1" source="cat1" target="at1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b2" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#7F7F7F;" edge="1" parent="1" source="cat2" target="at2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b3" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#7F7F7F;" edge="1" parent="1" source="cat3" target="at3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b4" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#7F7F7F;" edge="1" parent="1" source="cat4" target="at4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b5" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#7F7F7F;" edge="1" parent="1" source="cat5" target="at5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b6" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#7F7F7F;" edge="1" parent="1" source="cat6" target="at6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>